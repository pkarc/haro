{
  "name": "@haro/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"require('fs').writeFileSync('dist/.keep','')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "build:wasm": "tsc -b && VITE_CORE=wasm vite build --outDir dist-wasm --emptyOutDir",
    "preview:wasm": "vite preview --outDir dist-wasm --port 7473 --strictPort --host 127.0.0.1",
    "test:e2e:wasm": "npm run build:wasm && playwright test --project=wasm"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
