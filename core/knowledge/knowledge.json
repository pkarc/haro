  "sections": {
    "global": {
      "color": "#a78bfa",
      "named": "none",
      "title": "Configuración global",
      "description": "Ajustes de todo el proceso HAProxy: usuario y grupo, logs, límite de conexiones, socket de administración y TLS por defecto."
    },
    "defaults": {
      "color": "#94a3b8",
      "named": "optional",
      "title": "Valores por defecto",
      "description": "Todo lo que pongas aquí lo heredan los frontend, backend y listen que aparecen después (hasta el siguiente defaults)."
    },
    "frontend": {
      "color": "#38bdf8",
      "named": "required",
      "title": "Entrada de tráfico",
      "description": "Dónde escucha HAProxy (bind) y qué reglas deciden a qué backend va cada petición."
    },
    "backend": {
      "color": "#fbbf24",
      "named": "required",
      "title": "Grupo de servidores",
      "description": "Los servidores destino, cómo se reparte la carga entre ellos y cómo se comprueba su salud."
    },
    "listen": {
      "color": "#4ade80",
      "named": "required",
      "title": "Entrada + servidores",
      "description": "Frontend y backend en una sola sección. Típico para servicios TCP o la página de estadísticas."
    },
    "resolvers": {
      "color": "#f472b6",
      "named": "required",
      "title": "Resolución DNS",
      "description": "Servidores DNS que HAProxy consulta para resolver en caliente los nombres de los servidores."
    },
    "peers": {
      "color": "#fb923c",
      "named": "required",
      "title": "Réplicas (peers)",
      "description": "Otras instancias de HAProxy con las que sincronizar stick-tables (persistencia, rate limits)."
    },
    "userlist": {
      "color": "#e879f9",
      "named": "required",
      "title": "Usuarios",
      "description": "Usuarios y grupos para autenticación HTTP básica."
    },
    "mailers": {
      "color": "#f472b6",
      "named": "required",
      "title": "Alertas por email",
      "description": "Servidores SMTP para avisar de cambios de estado de los servidores."
    },
    "cache": {
      "color": "#2dd4bf",
      "named": "required",
      "title": "Caché HTTP",
      "description": "Caché en memoria para respuestas HTTP pequeñas y frecuentes."
    },
    "http-errors": {
      "color": "#f87171",
      "named": "required",
      "title": "Páginas de error",
      "description": "Conjunto reutilizable de páginas de error personalizadas."
    },
    "ring": {
      "color": "#94a3b8",
      "named": "required",
      "title": "Buffer de logs",
      "description": "Buffer circular en memoria para logs o trazas."
    },
    "program": {
      "color": "#94a3b8",
      "named": "required",
      "title": "Programa externo",
      "description": "Proceso externo que el maestro de HAProxy arranca y supervisa."
    }
